body {
    width: 360px;
    height: 100%;
    margin: 0;
    color: #e4e8e7;
    background: #0a0c0f;
    font-family: LXGW Fasmart Gothic;
    font-size: 15px;
}

.composer-titlebar {
    height: 68px;
    padding: 14px 16px 10px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px #263036;
    background: #0d1114;
}

h1, h2, p { margin: 0; }
h1 { font-size: 21px; font-weight: 500; letter-spacing: 0.5px; }
h2 { font-size: 15px; font-weight: 500; }
.state-label { margin-top: 3px; color: #28c9c3; font-size: 12px; }

.composer-scroll {
    position: absolute;
    top: 68px;
    bottom: 92px;
    left: 0;
    right: 0;
    padding: 14px 12px 24px 12px;
    overflow-y: auto;
    scrollbar-margin: 3px;
}

.help-copy { display: none; margin-bottom: 10px; padding: 10px; color: #bdc8c6; background: #122023; border-left: 3px #28c9c3; }

.workflow-card {
    display: block;
    margin-bottom: 10px;
    padding: 14px;
    border: 1px #2c363b;
    border-radius: 10px;
    background: #171d21;
}

.supporting-copy, .muted { margin-top: 7px; color: #93a09e; line-height: 1.35; }
.section-heading, .action-row, .year-fields {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

button, select, input {
    min-height: 34px;
    color: #e4e8e7;
    background: #0f1417;
    border: 1px #364249;
    border-radius: 7px;
}
button { padding: 7px 10px; }
button:hover { border-color: #28c9c3; }
button:focus, select:focus, input:focus { border-color: #a7efe9; }
button:disabled { color: #66716f; border-color: #283035; }
select, input { width: 100%; padding: 6px 8px; }

.icon-control { width: 32px; min-height: 32px; padding: 0; border-radius: 16px; }
.status-chip { padding: 3px 7px; color: #e1bd62; background: #272315; border-radius: 8px; }
.target-title { margin-top: 10px; font-size: 16px; }
.coordinate-readout { margin-top: 5px; color: #49d5d0; font-family: monospace; }
.lock-note { margin-top: 9px; color: #b8c5c2; font-size: 12px; }
.action-row { margin-top: 10px; }
.action-row button { flex: 1; }
.locked-actions { display: none; }

.year-fields { margin-top: 10px; align-items: end; }
.year-fields label { width: 54px; color: #93a09e; font-size: 11px; }
.year-fields input { width: 68px; }
.range-connector { width: 22px; height: 1px; margin-bottom: 16px; background: #28c9c3; }
.range-strip { height: 4px; margin-top: 12px; background: #263034; border-radius: 2px; }
.range-strip span { display: block; width: 45%; height: 4px; margin-left: 48%; background: #28c9c3; }
.field-error, .operation-error { min-height: 0; margin-top: 7px; color: #ef6a62; }

.disclosure-toggle { width: 100%; color: #ccd4d2; }
.cost-body { display: none; }
.cost-grid { display: block; margin-top: 12px; }
.cost-grid dt { margin-top: 6px; color: #93a09e; }
.cost-grid dd { text-align: right; }

.run-footer {
    position: absolute;
    height: 92px;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px 14px 12px 14px;
    border-top: 1px #2b373c;
    background: #0d1114;
}
.primary-action { width: 100%; color: #061211; background: #28c9c3; border-color: #28c9c3; font-weight: 600; }
.primary-action:hover { background: #51ddd6; }
.progress-footer { display: none; margin-bottom: 8px; }
.progress-footer progress { width: 100%; height: 5px; }
.operation-error { padding: 0; }

.report-layer { width: 100%; height: 100%; background: transparent; pointer-events: none; }
.live-target-overlay { display: none; position: absolute; pointer-events: none; z-index: 1; }
.live-target-requested { border: 2px #49d5d0; }
.live-target-actual { border: 2px #e1bd62; }
.live-target-label { display: none; position: absolute; max-width: 260px; margin: 10px; padding: 5px 8px; color: #e4e8e7; background: #0a0c0fcc; border-left: 3px #49d5d0; border-radius: 5px; pointer-events: none; z-index: 2; }
.science-report { display: none; position: absolute; width: 900px; height: 680px; min-width: 560px; min-height: 400px; max-width: 1200px; max-height: 900px; color: #e4e8e7; background: #0a0c0f; border: 1px #354249; border-radius: 12px; overflow: hidden; pointer-events: auto; z-index: 10; }
.report-titlebar { height: 64px; display: flex; align-items: center; justify-content: space-between; background: #11171a; border-bottom: 1px #2c363b; }
.report-move-handle { display: block; flex: 1; height: 64px; padding: 11px 16px; cursor: move; }
.report-subtitle { margin-top: 3px; color: #93a09e; font-size: 12px; }
.report-window-actions { display: flex; padding-right: 10px; }
.report-window-actions button { margin-left: 6px; }
.report-tabs { height: 48px; display: flex; padding: 7px 12px; background: #0d1114; border-bottom: 1px #263036; }
.report-tabs button { margin-right: 7px; color: #aab5b3; background: transparent; border-color: transparent; }
.report-tabs button.selected { color: #e4e8e7; border-bottom: 2px #28c9c3; }
.report-content { position: absolute; top: 112px; left: 0; right: 0; bottom: 0; padding: 18px; overflow-y: auto; scrollbar-margin: 3px; }
.report-section { display: none; }
#overview { display: block; }
.context-thumbnail { position: relative; height: 250px; padding: 16px; background: #101619; border: 1px #2c363b; border-radius: 9px; overflow: hidden; }
.context-image { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.context-overlay { display: none; position: absolute; pointer-events: none; }
.requested-overlay { border: 2px #49d5d0; }
.actual-overlay { border: 2px #e1bd62; }
.analysis-range-key { margin-top: 16px; color: #49d5d0; }
.context-caption { margin-top: 7px; color: #93a09e; font-size: 12px; }
.report-summary, .science-chart, .chart-statistics { margin-top: 14px; padding: 14px; background: #12181b; border-radius: 8px; }
.overview-facts { display: flex; margin-top: 12px; }
.overview-facts div { flex: 1; margin-right: 8px; padding: 11px; background: #12181b; border-radius: 7px; }
.overview-facts span { display: block; color: #93a09e; font-size: 11px; }
.overview-facts strong { display: block; margin-top: 5px; font-weight: 500; }
.evidence-card { margin-top: 12px; padding: 14px; background: #12181b; border: 1px #263036; border-radius: 8px; }
.evidence-card h3 { margin: 0 0 8px 0; color: #a7efe9; font-size: 13px; font-weight: 500; }
.evidence-card p { margin-top: 5px; line-height: 1.4; }
.evidence-list { margin: 5px 0 0 18px; padding: 0; color: #bdc8c6; }
.source-url { color: #49d5d0; }
.chart-toolbar { display: flex; align-items: center; }
.chart-toolbar select { margin-left: 12px; }
.science-chart { display: block; height: 300px; cursor: crosshair; }
.chart-readout { display: flex; justify-content: space-between; margin-top: 7px; color: #93a09e; font-size: 12px; }
.delete-confirmation { display: none; position: absolute; right: 16px; top: 58px; width: 280px; padding: 16px; background: #231315; border: 1px #874641; border-radius: 8px; z-index: 5; }
.delete-confirmation p { margin: 10px 0; color: #d9b4b0; }
.destructive-action { color: #fff; background: #a93e38; border-color: #ef6a62; }
.resize-handle { position: absolute; display: block; }
.resize-right { width: 8px; top: 64px; right: 0; bottom: 12px; cursor: resize; }
.resize-bottom { height: 8px; left: 0; right: 12px; bottom: 0; cursor: resize; }
.resize-corner { width: 18px; height: 18px; right: 0; bottom: 0; cursor: resize; }
.report-shelf { display: none; position: absolute; left: 50%; bottom: 124px; padding: 7px; background: #0d1114; border: 1px #2c363b; border-radius: 9px; pointer-events: auto; }
.report-shelf button { margin: 0 4px; }
