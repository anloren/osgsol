#science-workbench {
    display: block;
    box-sizing: border-box;
    position: absolute;
    left: 76px;
    top: 56px;
    width: 360px;
    height: 720px;
    margin: 0;
    color: #e5e4df;
    background: #0d1011;
    font-family: LXGW Fasmart Gothic;
    font-size: 15px;
}

.composer-titlebar {
    box-sizing: border-box;
    width: 100%;
    height: 68px;
    padding: 14px 16px 10px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px #3b302e;
    background: #07090a;
}

h1, h2, h3, p, label, dl, dt, dd, article { display: block; margin: 0; }
h1 { font-size: 21px; font-weight: 500; letter-spacing: 0.5px; }
h2 { font-size: 15px; font-weight: 500; }
.state-label { margin-top: 3px; color: #38c3df; font-size: 12px; }

.composer-scroll {
    display: block;
    box-sizing: border-box;
    width: 100%;
    position: absolute;
    top: 68px;
    bottom: 72px;
    left: 0;
    right: 0;
    padding: 14px 14px 24px 14px;
    overflow-x: hidden;
    overflow-y: auto;
}

scrollbarvertical {
    width: 8px;
}
scrollbarvertical slidertrack {
    width: 8px;
    background: #0d1011;
}
scrollbarvertical sliderbar {
    width: 8px;
    min-height: 40px;
    background: #3b302e;
    border-radius: 3px;
}
scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background: #38c3df;
}
scrollbarhorizontal {
    width: 0;
    height: 0;
}
scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
}

.help-copy {
    display: none;
    box-sizing: border-box;
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    color: #a7aaa6;
    background: #141719;
    border-left: 3px #38c3df;
    white-space: normal;
    word-break: break-word;
}

.workflow-card {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin-bottom: 10px;
    padding: 14px;
    border: 1px #3b302e;
    border-radius: 4px;
    background: #141719;
}

.supporting-copy, .muted { margin-top: 7px; color: #a7aaa6; line-height: 1.35; white-space: normal; word-break: break-word; }
.workflow-card > .supporting-copy, .workflow-card > .muted {
    box-sizing: border-box;
    width: 100%;
}
.section-heading, .action-row, .year-fields {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

button, select, input {
    display: inline-block;
    box-sizing: border-box;
    min-height: 34px;
    color: #e5e4df;
    background: #0d1011;
    border: 1px #3b302e;
    border-radius: 3px;
}
button { padding: 7px 10px; }
button:hover { border-color: #38c3df; background: #1a1e20; }
button:focus, select:focus, input:focus { border-color: #38c3df; }
button:disabled { color: #737a78; border-color: #3b302e; }
select, input { width: 100%; padding: 6px 8px; }
select, input { display: block; }

.select-shell {
    display: block;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    height: 34px;
}
.select-shell select {
    width: 100%;
    height: 34px;
}
.select-chevron {
    display: block;
    box-sizing: border-box;
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    width: 34px;
    height: 34px;
    padding-top: 8px;
    color: #a7aaa6;
    text-align: center;
    font-size: 11px;
    pointer-events: none;
}
.select-shell:hover .select-chevron {
    color: #38c3df;
}

select selectvalue {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 32px;
    padding: 6px 38px 6px 8px;
    color: #e5e4df;
    white-space: nowrap;
    overflow: hidden;
}
select selectarrow {
    display: block;
    box-sizing: border-box;
    width: 34px;
    height: 34px;
    color: transparent;
    background: transparent;
    border-left: 0;
}
select:hover selectarrow,
select:focus selectarrow,
select selectarrow:checked {
    background: transparent;
    border-left: 0;
}
select selectbox {
    display: block;
    box-sizing: border-box;
    width: 100%;
    max-height: 280px;
    margin-top: 4px;
    padding: 4px;
    color: #e5e4df;
    background: #0d1011;
    border: 1px #55413d;
    border-radius: 3px;
}
select selectbox option {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-height: 34px;
    padding: 7px 9px;
    color: #e5e4df;
    background: #0d1011;
    white-space: normal;
    word-break: break-word;
}
select selectbox option:hover {
    color: #e5e4df;
    background: #1a1e20;
}
select selectbox option:checked {
    color: #e5e4df;
    background: #380f0c;
}
select selectbox option.disabled {
    color: #737a78;
    background: #141719;
}

.icon-control { width: 32px; min-height: 32px; padding: 0; border-radius: 16px; }
.status-chip { padding: 3px 7px; color: #e1bd62; background: #141719; border: 1px #3b302e; border-radius: 3px; }
.target-title { margin-top: 10px; font-size: 16px; }
.coordinate-readout { margin-top: 5px; color: #38c3df; font-family: LXGW Fasmart Gothic; }
.lock-note { margin-top: 9px; color: #a7aaa6; font-size: 12px; }
.action-row { margin-top: 10px; }
.action-row button { flex: 1; }
.locked-actions { display: none; }

.year-fields { width: 100%; margin-top: 10px; align-items: flex-end; }
.year-field { display: block; flex: 1; min-width: 0; }
.year-field label { width: 100%; margin-bottom: 5px; color: #a7aaa6; font-size: 11px; }
.year-field input { width: 100%; }
.range-connector { width: 18px; height: 1px; margin: 0 7px 17px 7px; background: #38c3df; }
.range-summary { margin-top: 9px; color: #a7aaa6; font-size: 12px; }
.field-error, .operation-error { min-height: 0; margin-top: 7px; color: #ef6a62; }

.disclosure-toggle { width: 100%; color: #a7aaa6; }
.cost-body { display: none; }
.cost-grid { display: block; margin-top: 12px; }
.cost-grid dt { margin-top: 6px; color: #a7aaa6; }
.cost-grid dd { text-align: right; }

.run-footer {
    display: block;
    box-sizing: border-box;
    width: 100%;
    position: absolute;
    height: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 8px 14px;
    border-top: 1px #3b302e;
    background: #07090a;
}
.primary-action { width: 100%; color: #07090a; background: #38c3df; border-color: #38c3df; font-weight: 600; }
.primary-action:hover { background: #e1bd62; border-color: #e1bd62; }
.primary-action:disabled, .primary-action.disabled { color: #737a78; background: #141719; border-color: #3b302e; }
.run-feedback {
    display: block;
    min-height: 17px;
    margin-bottom: 5px;
    color: #a7aaa6;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
}
.progress-footer {
    display: none;
    box-sizing: border-box;
    width: 100%;
    height: 50px;
}
.progress-header {
    display: flex;
    box-sizing: border-box;
    width: 100%;
    height: 34px;
    align-items: center;
    justify-content: space-between;
}
.progress-header span {
    display: block;
    flex: 1;
    color: #a7aaa6;
    white-space: nowrap;
    overflow: hidden;
}
.progress-header button {
    width: 64px;
    min-height: 28px;
    padding: 4px 8px;
}
.progress-footer progress {
    display: block;
    width: 100%;
    height: 5px;
    margin-top: 5px;
}
.operation-error { padding: 0; }

.report-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin: 0; color: #e5e4df; background: transparent; font-family: LXGW Fasmart Gothic; font-size: 15px; pointer-events: none; }
.live-target-overlay { display: none; position: absolute; pointer-events: none; z-index: 1; }
.live-target-requested { border: 2px #38c3df; }
.live-target-actual { border: 2px #e1bd62; }
.live-target-label { display: none; position: absolute; max-width: 260px; margin: 10px; padding: 5px 8px; color: #e5e4df; background: #07090acc; border-left: 3px #38c3df; border-radius: 3px; pointer-events: none; z-index: 2; }
.science-report { display: none; position: absolute; width: 900px; height: 680px; min-width: 720px; min-height: 520px; max-width: 1200px; max-height: 900px; color: #e5e4df; background: #0d1011; border: 1px #3b302e; border-radius: 6px; overflow: hidden; pointer-events: auto; z-index: 10; }
.report-titlebar { height: 64px; display: flex; align-items: center; justify-content: space-between; background: #07090a; border-bottom: 1px #3b302e; }
.report-move-handle { display: block; flex: 1; min-width: 0; height: 64px; padding: 11px 16px; cursor: move; overflow: hidden; }
.report-subtitle { margin-top: 3px; color: #a7aaa6; font-size: 12px; }
.report-window-actions { display: flex; flex-shrink: 0; padding-right: 10px; }
.report-window-actions button { margin-left: 6px; }
#report-close { margin-right: 8px; }
.report-tabs { height: 48px; display: flex; padding: 7px 12px; background: #0d1011; border-bottom: 1px #3b302e; }
.report-tabs button { margin-right: 7px; color: #a7aaa6; background: transparent; border-color: transparent; }
.report-tabs button.selected { color: #e5e4df; border-bottom: 2px #38c3df; }
.report-content { position: absolute; top: 112px; left: 0; right: 0; bottom: 0; padding: 18px; overflow-y: auto; }
.report-section { display: none; }
#overview { display: block; }
.context-thumbnail { position: relative; width: 512px; height: 288px; margin-left: auto; margin-right: auto; padding: 0; background: #141719; border: 1px #3b302e; border-radius: 4px; overflow: hidden; }
.context-image { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.context-overlay { display: none; position: absolute; pointer-events: none; }
.requested-overlay { border: 2px #38c3df; }
.actual-overlay { border: 2px #e1bd62; }
.analysis-range-key { margin-top: 16px; color: #38c3df; }
.context-caption { margin-top: 7px; color: #a7aaa6; font-size: 12px; }
.report-summary, .chart-statistics { display: block; box-sizing: border-box; width: 100%; margin-top: 14px; padding: 14px; background: #141719; border-radius: 4px; }
.overview-facts { display: flex; margin-top: 12px; }
.overview-facts div { flex: 1; margin-right: 8px; padding: 11px; background: #141719; border-radius: 4px; }
.overview-facts span { display: block; color: #a7aaa6; font-size: 11px; }
.overview-facts strong { display: block; margin-top: 5px; font-weight: 500; }
.evidence-card { margin-top: 12px; padding: 14px; background: #141719; border: 1px #3b302e; border-radius: 4px; }
.evidence-card h3 { margin: 0 0 8px 0; color: #38c3df; font-size: 13px; font-weight: 500; }
.evidence-card p { margin-top: 5px; line-height: 1.4; }
.evidence-list { margin: 5px 0 0 18px; padding: 0; color: #a7aaa6; }
.source-url { color: #38c3df; }
.chart-toolbar { display: flex; align-items: flex-end; justify-content: space-between; }
.chart-heading { display: block; flex: 1; }
.chart-heading h2 { font-size: 18px; }
.chart-metric-control { display: block; width: 300px; }
.chart-metric-control label { color: #a7aaa6; font-size: 11px; }
.chart-metric-control select { margin-top: 5px; }
.chart-panel { display: block; margin-top: 14px; padding: 14px; background: #141719; border: 1px #3b302e; border-radius: 4px; }
.chart-unit-row { display: flex; align-items: center; justify-content: space-between; color: #a7aaa6; font-size: 12px; }
.chart-unit-row strong { color: #e5e4df; font-weight: 500; }
.chart-body { display: flex; margin-top: 10px; }
.chart-y-axis { display: flex; width: 82px; height: 300px; flex-direction: column; justify-content: space-between; padding: 14px 8px 22px 0; color: #a7aaa6; text-align: right; font-size: 11px; }
.chart-plot { display: block; flex: 1; min-width: 0; }
.science-chart { display: block; height: 300px; cursor: crosshair; background: #0d1011; border: 1px #3b302e; border-radius: 3px; }
.chart-x-axis { display: flex; justify-content: space-between; padding: 5px 18px 0 18px; color: #a7aaa6; font-size: 11px; }
.chart-missing-note { margin-top: 8px; color: #737a78; font-size: 11px; }
.chart-readout { display: flex; justify-content: space-between; margin-top: 7px; color: #a7aaa6; font-size: 12px; }
.delete-confirmation { display: none; position: absolute; right: 16px; top: 58px; width: 280px; padding: 16px; background: #380f0c; border: 1px #ef6a62; border-radius: 4px; z-index: 5; }
.delete-confirmation p { margin: 10px 0; color: #e5e4df; }
.destructive-action { color: #e5e4df; background: #d33123; border-color: #ef6a62; }
.resize-handle { position: absolute; display: block; }
.resize-right { width: 8px; top: 64px; right: 0; bottom: 12px; cursor: resize; }
.resize-bottom { height: 8px; left: 0; right: 12px; bottom: 0; cursor: resize; }
.resize-corner { width: 18px; height: 18px; right: 0; bottom: 0; cursor: resize; }
.report-shelf { display: none; position: absolute; left: 50%; bottom: 124px; padding: 7px; background: #0d1011; border: 1px #3b302e; border-radius: 4px; pointer-events: auto; }
.report-shelf button { margin: 0 4px; }
