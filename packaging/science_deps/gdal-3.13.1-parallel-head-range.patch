+static bool ParseParallelContentRange(const std::string &osHeaders,
+                                      GUIntBig &nTotal)
+{
+    std::string osValue{};
+    size_t nLineOffset = 0;
+    int nContentRangeCount = 0;
+    while (nLineOffset < osHeaders.size())
+    {
+        const size_t nLineEnd = osHeaders.find('\n', nLineOffset);
+        std::string osLine = osHeaders.substr(
+            nLineOffset, nLineEnd == std::string::npos
+                             ? std::string::npos
+                             : nLineEnd - nLineOffset);
+        if (!osLine.empty() && osLine.back() == '\r')
+            osLine.pop_back();
+        const size_t nColonOffset = osLine.find(':');
+        if (nColonOffset != std::string::npos &&
+            EQUAL(osLine.substr(0, nColonOffset).c_str(), "Content-Range"))
+        {
+            if (++nContentRangeCount != 1)
+                return false;
+            osValue = osLine.substr(nColonOffset + 1);
+        }
+        if (nLineEnd == std::string::npos)
+            break;
+        nLineOffset = nLineEnd + 1;
+    }
+    if (nContentRangeCount != 1)
+        return false;
+    while (!osValue.empty() && isspace(static_cast<unsigned char>(osValue.front())))
+        osValue.erase(osValue.begin());
+    while (!osValue.empty() && isspace(static_cast<unsigned char>(osValue.back())))
+        osValue.pop_back();
+    std::transform(osValue.begin(), osValue.end(), osValue.begin(),
+                   [](unsigned char ch) { return static_cast<char>(tolower(ch)); });
