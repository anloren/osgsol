+static bool IsParallelHeadRangeTransientStatus(long nStatus)
+{
+    switch (nStatus)
+    {
+        case 429:
+        case 500:
+        case 502:
+        case 503:
+        case 504:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool IsImmediateMultiRangeTransientStatus(long nStatus)
+{
+    switch (nStatus)
+    {
+        case 429:
+        case 500:
+        case 502:
+        case 503:
+        case 504:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static size_t ParallelHeadRangeWriteFunc(void *pBuffer, size_t nSize,
+                                         size_t nCount, void *pUserData)
+{
+    auto *psWriter = static_cast<ParallelHeadRangeWriter *>(pUserData);
+    if (psWriter->nConnectionId < 0 && psWriter->hCurlHandle)
+    {
+        curl_easy_getinfo(psWriter->hCurlHandle, CURLINFO_CONN_ID,
+                          &psWriter->nConnectionId);
+    }
+    if (nSize != 0 && nCount > std::numeric_limits<size_t>::max() / nSize)
+    {
+        psWriter->bOverflow = true;
+        return 0;
+    }
+    const size_t nBytes = nSize * nCount;
+    if (nBytes > std::numeric_limits<size_t>::max() - psWriter->nAttemptedSize)
+    {
+        psWriter->nAttemptedSize = std::numeric_limits<size_t>::max();
+        psWriter->bOverflow = true;
+        return 0;
+    }
+    psWriter->nAttemptedSize += nBytes;
+    if (nBytes > ParallelHeadRangeWriter::knCAPACITY - psWriter->abyBuffer.size())
+    {
+        psWriter->bOverflow = true;
+        return 0;
+    }
+    const auto *pabyData = static_cast<const GByte *>(pBuffer);
+    psWriter->abyBuffer.insert(psWriter->abyBuffer.end(), pabyData,
+                               pabyData + nBytes);
+    return nBytes;
+}
