+/*                    AbandonCurlMultiHandle()                          */
+/************************************************************************/
+
+bool VSICurlFilesystemHandlerBase::AbandonCurlMultiHandle(
+    CURLM *hFailedMultiHandle)
+{
+    auto &conn = GetConnectionCache()[this];
+    if (conn.hCurlMultiHandle != hFailedMultiHandle)
+        return false;
+    conn.hCurlMultiHandle = nullptr;
+    conn.bParallelHeadRangeDisabled = true;
+    return true;
+}
+
+/************************************************************************/
+/*                  IsParallelHeadRangeDisabled()                       */
+/************************************************************************/
+
+bool VSICurlFilesystemHandlerBase::IsParallelHeadRangeDisabled()
+{
+    return GetConnectionCache()[this].bParallelHeadRangeDisabled;
+}
+
+/************************************************************************/
+/*                 MarkParallelHeadRangeBlocked()                       */
+/************************************************************************/
+
+void VSICurlFilesystemHandlerBase::MarkParallelHeadRangeBlocked(
+    const std::string &osFilename)
+{
+    constexpr std::chrono::seconds BLOCKED_PROBE_EXPIRY{5};
+    GetConnectionCache()[this].oParallelHeadRangeBlockedPaths[osFilename] =
+        std::chrono::steady_clock::now() + BLOCKED_PROBE_EXPIRY;
+    CPLDebug(GetDebugKey(),
+             "ParallelHeadRange: blocked-probe-marked expiry-ms=5000");
+}
+
+/************************************************************************/
+/*                ConsumeParallelHeadRangeBlocked()                     */
+/************************************************************************/
+
+bool VSICurlFilesystemHandlerBase::ConsumeParallelHeadRangeBlocked(
+    const std::string &osFilename)
+{
+    auto &oBlocked =
+        GetConnectionCache()[this].oParallelHeadRangeBlockedPaths;
+    const auto oIter = oBlocked.find(osFilename);
+    if (oIter == oBlocked.end())
+        return false;
+    const bool bValid =
+        oIter->second >= std::chrono::steady_clock::now();
+    oBlocked.erase(oIter);
+    CPLDebug(GetDebugKey(),
+             "ParallelHeadRange: blocked-probe-%s",
+             bValid ? "consumed" : "expired");
+    return bValid;
+}
+
