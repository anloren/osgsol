+enum class ParallelHeadRangeRetryEligibility
+{
+    ELIGIBLE,
+    HEAD_INVALID,
+    HEAD_TRANSPORT,
+    HEAD_REDIRECT,
+    HEAD_PROTOCOL,
+    HEAD_CONNECTION,
+    RANGE_TRANSPORT,
+    RANGE_REDIRECT,
+    RANGE_PROTOCOL,
+    RANGE_CONNECTION,
+};
+
+static ParallelHeadRangeRetryEligibility GetParallelHeadRangeRetryEligibility(
+    const ParallelHeadRangeResult &sResult)
+{
+    if (!sResult.bHeadDone || sResult.eHeadCurlCode != CURLE_OK)
+        // head-transport
+        return ParallelHeadRangeRetryEligibility::HEAD_TRANSPORT;
+    if (sResult.nHeadCode != 200 || sResult.nHeadSize <= 0)
+        // head-invalid
+        return ParallelHeadRangeRetryEligibility::HEAD_INVALID;
+    if (sResult.nHeadRedirectCount != 0)
+        // head-redirect
+        return ParallelHeadRangeRetryEligibility::HEAD_REDIRECT;
+    if (sResult.nHeadHTTPVersion != CURL_HTTP_VERSION_2_0)
+        // head-protocol
+        return ParallelHeadRangeRetryEligibility::HEAD_PROTOCOL;
+    if (sResult.nHeadConnectionId < 0)
+        // head-connection
+        return ParallelHeadRangeRetryEligibility::HEAD_CONNECTION;
+    if (!sResult.bRangeDone || sResult.eRangeCurlCode != CURLE_OK)
+        // range-transport
+        return ParallelHeadRangeRetryEligibility::RANGE_TRANSPORT;
+    if (sResult.nRangeRedirectCount != 0)
+        // range-redirect
+        return ParallelHeadRangeRetryEligibility::RANGE_REDIRECT;
+    if (sResult.nRangeHTTPVersion != CURL_HTTP_VERSION_2_0)
+        // range-protocol
+        return ParallelHeadRangeRetryEligibility::RANGE_PROTOCOL;
+    if (sResult.nRangeConnectionId < 0 ||
+        sResult.nRangeConnectionId != sResult.nHeadConnectionId)
+    {
+        // range-connection
+        return ParallelHeadRangeRetryEligibility::RANGE_CONNECTION;
+    }
+    return ParallelHeadRangeRetryEligibility::ELIGIBLE;
+}
+
+static const char *ParallelHeadRangeRetryEligibilityName(
+    ParallelHeadRangeRetryEligibility eEligibility)
+{
+    switch (eEligibility)
+    {
+        case ParallelHeadRangeRetryEligibility::ELIGIBLE:
+            return "eligible";
+        case ParallelHeadRangeRetryEligibility::HEAD_INVALID:
+            return "head-invalid";
+        case ParallelHeadRangeRetryEligibility::HEAD_TRANSPORT:
+            return "head-transport";
+        case ParallelHeadRangeRetryEligibility::HEAD_REDIRECT:
+            return "head-redirect";
+        case ParallelHeadRangeRetryEligibility::HEAD_PROTOCOL:
+            return "head-protocol";
+        case ParallelHeadRangeRetryEligibility::HEAD_CONNECTION:
+            return "head-connection";
+        case ParallelHeadRangeRetryEligibility::RANGE_TRANSPORT:
+            return "range-transport";
+        case ParallelHeadRangeRetryEligibility::RANGE_REDIRECT:
+            return "range-redirect";
+        case ParallelHeadRangeRetryEligibility::RANGE_PROTOCOL:
+            return "range-protocol";
+        case ParallelHeadRangeRetryEligibility::RANGE_CONNECTION:
+            return "range-connection";
+    }
+    return "head-invalid";
+}
